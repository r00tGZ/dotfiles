#!/bin/sh

set -eu

etchosts='/etc/hosts'
bashrc="$HOME/.bashrc"
zshrc="$HOME/.zshrc"

comment_slug='# HTB'
alias_slug='IP'
ipv4_regex='^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$'

case $# in
    0)
        grep -F "$comment_slug" "$etchosts"
        ;;

    1)
        if [ "$1" = "-" ]; then
            sudo sed -i "\|$comment_slug|d" "$etchosts"
            for rc in "$bashrc" "$zshrc"; do
                [ -f "$rc" ] && sed -i "\|$comment_slug|d" "$rc"
            done

        else
            echo "Usage: $(basename "$0") [IP HOST [HOST...]] | -" >&2
            exit 1

        fi
        ;;

    *)
        ip=$1
        shift

		if ! printf '%s\n' "$ip" | grep -Eq "$ipv4_regex"; then
            echo "Invalid IP address: $ip (expected IPv4 or unscoped IPv6)." >&2
            exit 1
        fi
        for host do
            case "$host" in
                ''|*[!A-Za-z0-9.-]*)
                    echo "Invalid hostname: $host" >&2
                    exit 1
                    ;;
            esac
        done

        grep -qF "$comment_slug" "$etchosts" && echo "Warning: existing HTB entry will be replaced." >&2

        sudo sed -i "\|$comment_slug|d" "$etchosts"
        printf '%s\t%s\t%s\n' "$ip" "$*" "$comment_slug" | sudo tee -a "$etchosts" >/dev/null

        for rc in "$bashrc" "$zshrc"; do
            if [ -f "$rc" ]; then
                sed -i "\|$comment_slug|d" "$rc"
                printf "export %s='%s'\t%s\n" "$alias_slug" "$ip" "$comment_slug" >>"$rc"
            fi

        done
        ;;
esac
